<Window x:Class="LMC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LMC"
        mc:Ignorable="d"
        Title="LMC Editor - WTDawson"
        Height="450"
        Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="3">
            <MenuItem Header="File">
                <MenuItem Header="Open" />
                <MenuItem Header="Save" />
                <MenuItem Header="Save As..." />
            </MenuItem>
            <MenuItem Header="Run" />
            <MenuItem Header="View">
                <MenuItem Header="Memory" Name="ViewMemory" Click="ViewMemory_Click" />
                <MenuItem Header="Screen" Name="ViewScreen" Click="ViewScreen_Click" />
                <MenuItem Header="Help" Name="ViewHelp" Click="ViewHelp_Click" />
            </MenuItem>
        </Menu>

        <TextBox Grid.Row="1"
                 Name="Code"
                 AllowDrop="True"
                 VerticalScrollBarVisibility="Visible"
                 AcceptsReturn="True"
                 AcceptsTab="True" />

        <GridSplitter Grid.Column="1" Grid.Row="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <ScrollViewer Grid.Column="2" Grid.Row="1" Padding="5">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="Bold">Properties</TextBlock>

                <Separator />

                <TextBlock>Clock speed (Min 1, Max 1048576):</TextBlock>
                <TextBox Name="ClockSpeed" Text="1024" />

                <TextBlock>Memory (Min 100, Max 1048576):</TextBlock>
                <TextBox Name="MemorySize" Text="100" />

                <TextBlock>Input variables:</TextBlock>
                <ComboBox Name="InputVariables">
                    <ComboBoxItem IsSelected="True">No input</ComboBoxItem>
                    <ComboBoxItem>Up/Down/Left/Right</ComboBoxItem>
                </ComboBox>

                <TextBlock>Display size:</TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
